#: package/contents/ui/ConfigGeneral.qml:140
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain only if it rains for at least half of the daylight hours, "
"otherwise the better part of the day."
msgstr "Affiche la pluie seulement s'il pleut pendant au moins la moitié des heures de jour, sinon la meilleure partie de la journée."

#: package/contents/ui/ConfigGeneral.qml:141
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain if it rains for at least a quarter of the daylight hours, "
"otherwise the typical weather of the day."
msgstr "Affiche la pluie s'il pleut pendant au moins un quart des heures de jour, sinon le temps typique de la journée."

#: package/contents/ui/ConfigGeneral.qml:142
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain as soon as it rains during daylight, otherwise the worse part of "
"the day."
msgstr "Affiche la pluie dès qu'il pleut pendant la journée, sinon la moins bonne partie de la journée."

