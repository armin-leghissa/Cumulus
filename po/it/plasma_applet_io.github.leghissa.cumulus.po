#: package/contents/ui/ConfigGeneral.qml:140
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain only if it rains for at least half of the daylight hours, "
"otherwise the better part of the day."
msgstr ""
"Mostra la pioggia solo se piove per almeno metà delle ore di luce, "
"altrimenti la parte migliore della giornata."

#: package/contents/ui/ConfigGeneral.qml:141
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain if it rains for at least a quarter of the daylight hours, "
"otherwise the typical weather of the day."
msgstr ""
"Mostra la pioggia se piove per almeno un quarto delle ore di luce, "
"altrimenti il tempo tipico della giornata."

#: package/contents/ui/ConfigGeneral.qml:142
#, kde-format
msgctxt "@info"
msgid ""
"Shows rain as soon as it rains during daylight, otherwise the worse part of "
"the day."
msgstr ""
"Mostra la pioggia non appena piove durante le ore di luce, altrimenti la "
"parte peggiore della giornata."

